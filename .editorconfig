# Pins the file encoding conventions this repository already used.
#
# Visual Studio writes C# files as UTF-8 with a byte order mark. Tooling that
# writes them without one leaves Rider guessing at the encoding, which surfaces
# as "file was loaded in a wrong encoding: UTF-8".

root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln}]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
